# Local development settings. Copy to .env and fill in.
# On the VPS these live in /etc/crowstance/*.env (written by deploy/setup.sh).

# --- Telegram ---------------------------------------------------------------
# Use a separate "dev" bot for local testing (@BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Everyone else is ignored.
OWNER_TELEGRAM_ID=

# --- OpenCode ---------------------------------------------------------------
OPENCODE_URL=http://127.0.0.1:4096
# Any long random string; `npm run opencode` starts OpenCode with the same value
OPENCODE_SERVER_PASSWORD=
# Model provider keys. OpenCode uses these; the gateway reads CROWBOT_API_KEY for the
# model catalog (prices, capabilities), the balance floor, and /cost.
# crowbot: your 16-digit account number is the API key
CROWBOT_API_KEY=
# Optional: Anthropic's own API as a second provider
ANTHROPIC_API_KEY=

# --- Optional geocoder -------------------------------------------------------
# Provider-neutral HTTP endpoint. The adapter sends the place/address as `q`.
# The response may be an array or {"results": [...]} with name, lat/lon fields.
# GEOCODER_URL=https://your-geocoder.example/search
# GEOCODER_API_KEY=
# GEOCODER_TIMEOUT_MS=5000
# GEOCODER_MIN_INTERVAL_MS=1000

# --- Optional media understanding ---------------------------------------------
# Photos and voice messages become text for the (text-only) models via local
# engines; nothing leaves your machine. Set the binaries to enable.
# TESSERACT_BIN=/usr/bin/tesseract        # apt install tesseract-ocr
# TESSERACT_LANG=eng
# WHISPER_BIN=/opt/crowstance/bin/whisper-cli   # whisper.cpp CLI
# WHISPER_MODEL=/opt/crowstance/bin/ggml-base.en.bin
# FFMPEG_BIN=ffmpeg
# MEDIA_MAX_MB=20

# --- Local tool endpoint (must match the URL in opencode/opencode.json) -------
HQ_PORT=7801
HQ_MCP_TOKEN=
HQ_NOTIFY_TOKEN=

# --- Where things live (forward slashes, also on Windows) --------------------
ASSISTANT_HOME=./.dev-assistant
PROJECTS_DIR=./.dev-projects
DATA_DIR=./data

# --- Models (docs/SUBAGENTS.md) -----------------------------------------------
# The chat defaults to the assistant agent's model in opencode/opencode.json; /model changes it.
# Subagents and workers run on what config/kinds.json says (`every` is the default for all
# subagent kinds) unless you pick another with /model.
# CHAT_MODEL=crowbot/deepseek-v4.1-flash
# WORKER_MODEL=crowbot/gpt-6.1-sol
# MODEL_PROVIDER=crowbot                 # the OpenCode provider crowbot's catalog maps to
# CATALOG_URL=https://api.crowbot.sh/v1/models
# CATALOG_REFRESH_MIN=60
# KINDS_FILE=config/kinds.json

# --- Spend caps: ceilings (/limits can only make them stricter) ---------------
# DAILY_BUDGET_USD=20
# MONTHLY_BUDGET_USD=200
# SUBAGENT_DAILY_BUDGET_USD=5
# SUBAGENT_CALL_MAX_USD=0.5
# SUBAGENT_TURN_MAX_USD=1.5
# TASK_MAX_USD=5
# MODEL_MAX_PRICE_PER_1M=2               # blended 0.75*input + 0.25*output, USD per 1M tokens
# BALANCE_FLOOR_USD=1
# SUBAGENT_MAX_CONCURRENT=3
# SUBAGENT_MAX_PER_TURN=6
# SUBAGENT_TIMEOUT_SEC=600
# SUBAGENT_SYNC_SEC=120                  # keep below the hq MCP timeout in opencode.json

# --- Optional ---------------------------------------------------------------
# TZ=UTC
# QUIET_HOURS=23:00-08:00
# MORNING_CHECKIN=08:30
# MAX_WORKERS=3
# DEBOUNCE_MS=2000
# RETENTION_DAYS=30
# STUCK_AFTER_MIN=120
# BUSY_WATCHDOG_SEC=45
# LOG_LEVEL=info
