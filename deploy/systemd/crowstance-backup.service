[Unit]
Description=crowstance: export the allowlisted assistant memory
After=local-fs.target

[Service]
Type=oneshot
User=crow-backup
Group=crow-backup
Slice=crowstance.slice
Environment=HOME=/var/lib/crowstance-backup
Environment=GIT_CONFIG_NOSYSTEM=1
WorkingDirectory=/var/lib/crowstance-backup/export
ExecStart=/opt/crowstance/app/deploy/backup.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/crow-agent/assistant/memory
PrivateTmp=true
PrivateNetwork=true
ReadWritePaths=/var/lib/crowstance-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallFilter=@system-service
