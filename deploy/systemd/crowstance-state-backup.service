[Unit]
Description=crowstance: encrypted state backup (SQLite + memory)
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
Slice=crowstance.slice
Environment=HOME=/root
WorkingDirectory=/var/lib/crowstance-backup
ExecStart=/opt/crowstance/app/deploy/state-backup.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/crow-agent/assistant/memory
PrivateTmp=true
PrivateNetwork=true
ReadWritePaths=/var/lib/crowstance-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallFilter=@system-service
