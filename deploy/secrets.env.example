# Copy to deploy/secrets.env (git-ignored) and fill in. `deploy/deploy.sh <target> --setup` uploads it,
# setup.sh reads it, then shreds it on the server.

# The REAL bot (not your dev bot), from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id, from @userinfobot
OWNER_TELEGRAM_ID=
# crowbot account number (it is the API key)
CROWBOT_API_KEY=
# Optional: Anthropic's own API as a second provider
ANTHROPIC_API_KEY=
# TZ=UTC

# Local OCR + speech-to-text (photos and voice memos become text for the model).
# Default is yes; the installer asks when run interactively. Downloads a ~150MB whisper model.
# MEDIA_ENGINES=1

# --- Shared server (it also runs other things). Same as `deploy.sh ... --setup --shared`.
# SHARED=1
# Paths the agent must never see, e.g. the other project's code and data (see the --audit output):
# CROW_HIDE_PATHS="/var/www /srv/myapp"
# Override the resource caps (shared defaults: half the cores, 40% of RAM):
# CROW_CPU_QUOTA=200%
# CROW_MEMORY_MAX=6G
